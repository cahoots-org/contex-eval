# Native (non-Docker) Contex for the news-desk replays: same code as the image plus
# scripts/contex-mps.patch, embedding on the Mac GPU. Postgres stays in the contexeval compose stack.
DATABASE_URL=postgresql+asyncpg://contex:contex_password@127.0.0.1:5442/contex
CONTEX_HOST=127.0.0.1
CONTEX_PORT=8011
AUTH_ENABLED=false
CONTEX_PROTECTED_MODE=false
HYBRID_SEARCH_ENABLED=true
CONTEX_EMBED_DEVICE=mps
RECONCILE_SWEEP_SECONDS=18
